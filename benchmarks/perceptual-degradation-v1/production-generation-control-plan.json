      "family": "limiting",
      "channels": "linked",
      "algorithm": "Partition into consecutive ceil(sample_rate_hz/200) frame blocks. For each block, find the maximum absolute sample across channels. Use gain min(1, 16384/peak), apply it to the entire block with exact integer-ratio round-to-nearest ties-to-even, and saturate to signed-16. The final partial block is processed identically.",
      "integer_parameters": {
        "threshold_absolute_sample": 16384,
        "block_frames": "ceil(sample_rate_hz/200)",
        "gain_linking": "maximum_absolute_sample_across_channels"
